{
    "name": "codehighlighter",
    "displayName": "CodeHighlighter",
    "description": "Visually highlight selected code with color — like a text highlighter for your editor.",
    "version": "1.0.0",
    "publisher": "ace-dev",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codeHighlighter.highlightRed",
                "title": "🔴 Red"
            },
            {
                "command": "codeHighlighter.highlightGreen",
                "title": "🟢 Green"
            },
            {
                "command": "codeHighlighter.highlightYellow",
                "title": "🟡 Yellow"
            },
            {
                "command": "codeHighlighter.highlightPink",
                "title": "🩷 Pink"
            },
            {
                "command": "codeHighlighter.highlightPurple",
                "title": "🟣 Purple"
            },
            {
                "command": "codeHighlighter.highlightSkyBlue",
                "title": "🔵 Sky Blue"
            },
            {
                "command": "codeHighlighter.highlightLime",
                "title": "🟩 Lime"
            },
            {
                "command": "codeHighlighter.removeHighlight",
                "title": "Remove Highlight"
            },
            {
                "command": "codeHighlighter.clearAllHighlights",
                "title": "CodeHighlighter: Clear All Highlights"
            }
        ],
        "submenus": [
            {
                "id": "codeHighlighter.highlightSubmenu",
                "label": "Highlight Selection"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "codeHighlighter.highlightSubmenu",
                    "group": "9_cutcopypaste@5"
                },
                {
                    "command": "codeHighlighter.removeHighlight",
                    "group": "9_cutcopypaste@6"
                }
            ],
            "codeHighlighter.highlightSubmenu": [
                {
                    "command": "codeHighlighter.highlightRed"
                },
                {
                    "command": "codeHighlighter.highlightGreen"
                },
                {
                    "command": "codeHighlighter.highlightYellow"
                },
                {
                    "command": "codeHighlighter.highlightPink"
                },
                {
                    "command": "codeHighlighter.highlightPurple"
                },
                {
                    "command": "codeHighlighter.highlightSkyBlue"
                },
                {
                    "command": "codeHighlighter.highlightLime"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "16.x",
        "typescript": "^4.9.4"
    }
}